<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="380.0" prefWidth="480.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.yazidsistems.app.generaciondevariablesaleatorias.controller.ComposicionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Método de Composición">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Label text="Distribución Triangular Simétrica (U1 + U2)" textFill="#666666" />

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Label text="Cantidad de números a generar:" />
                <TextField fx:id="cantidadInput" prefWidth="60.0" text="10" />
            </children>
        </HBox>

        <Button text="Generar Variables por Composición" onAction="#generarVariablesComposicion" prefWidth="240.0" />

        <ListView fx:id="listView" prefHeight="160.0" prefWidth="200.0" />

        <Button text="Volver al Menú" onAction="#volverMenu" />
    </children>
</VBox>
